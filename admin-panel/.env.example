# Public browser-safe values only
# The server-only Cloud Run API base URL must never use a NEXT_PUBLIC_ prefix.
MAHI_API_BASE_URL=https://YOUR_CLOUD_RUN_SERVICE_URL

# During Google migration, keep legacy Supabase variables only while the current UI
# still depends on the old backend. Remove them after all routes are migrated and verified.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEVER put service-account credentials, Firebase Admin credentials, service-role keys,
# Gemini API keys, App Check secrets or recipe signing private keys in NEXT_PUBLIC_* variables.
# Firebase Authentication ID tokens are passed only in Authorization headers at request time.
# Cloud Run verifies ID tokens and Owner/Member role server-side; this API client is server-only.
