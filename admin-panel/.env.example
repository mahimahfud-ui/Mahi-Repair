# Public Supabase project settings. Never place service credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The Admin Panel never receives service-role/secret keys, database passwords,
# or recipe-signing private keys. Supabase injects its reserved SUPABASE_*
# runtime variables into Edge Functions only.
#
# Configure custom values directly in Supabase Edge Function Secrets:
# RECIPE_SIGNING_PRIVATE_KEY_PEM=<PKCS#8 RSA-3072 private key>
# ADMIN_ORIGIN=<exact HTTPS Admin Panel origin>
