# Public Supabase project settings. These are publishable project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY

# Server-only identifier for the existing active Owner account.
# Do not add the NEXT_PUBLIC_ prefix; this value must never reach the browser.
ADMIN_OWNER_EMAIL=owner@example.com

# The Owner enters an 8–12 digit numeric PIN on the login screen.
# The PIN is the existing Supabase Auth password for ADMIN_OWNER_EMAIL.
# It is stored/verified by Supabase Auth; do not put the PIN in this file.

# Keep privileged keys out of Cloud Run and source control:
# SUPABASE_SERVICE_ROLE_KEY=<never add to this app>
# RECIPE_SIGNING_PRIVATE_KEY_PEM=<store only in Supabase Edge Function Secrets>
# ADMIN_ORIGIN=<exact HTTPS Admin Panel origin; Supabase Edge Function Secret>
