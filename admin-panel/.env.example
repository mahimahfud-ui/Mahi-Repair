# Server-only Cloud Run API origin. Never expose this as NEXT_PUBLIC_*.
MAHI_API_BASE_URL=https://YOUR_CLOUD_RUN_SERVICE_URL

# Firebase Web API key is public Firebase client configuration; this server-side
# variable is used only for Firebase custom-token exchange and refresh endpoints.
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Optional production Admin origin for email links and approved callback generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEVER put service-account credentials, Firebase Admin credentials, OTP signing
# secrets, Gemini API keys, App Check debug tokens or RSA recipe private keys in
# NEXT_PUBLIC_* variables or this file. Store them in Google Secret Manager.
# Firebase ID/refresh tokens are stored only in HttpOnly cookies at runtime.
# The old Supabase source tree and dependencies remain for rollback/reference only;
# no Supabase URL or key is used by the migrated Admin application code.
