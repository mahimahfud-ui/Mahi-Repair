/** Hovering icon inside slowly expanding rings. Shared by empty and error states. */
@Composable
private fun FloatingIconStage(
    icon: ImageVector,
    tone: MahiTone,
) {
    val accent = tone.accent()
    val c = MahiTheme.colors
    val reduced = rememberReducedMotion()
    val transition = rememberInfiniteTransition(label = "stateStage")
    val ring by transition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(tween(3200, easing = LinearEasing)),
        label = "stateRing",
    )
    val bob by transition.animateFloat(
        initialValue = -5f,
        targetValue = 5f,
        animationSpec = infiniteRepeatable(tween(2600, easing = FastOutSlowInEasing), RepeatMode.Reverse),
        label = "stateBob",
    )

    Box(modifier = Modifier.size(132.dp), contentAlignment = Alignment.Center) {
        Canvas(modifier = Modifier.size(132.dp)) {
            val maxR = size.minDimension / 2f
            val phases = if (reduced) listOf(0.35f, 0.75f) else listOf(ring, (ring + 0.5f) % 1f)
            phases.forEach { p ->
                drawCircle(
                    color = accent.copy(alpha = 0.22f * (1f - p)),
                    radius = maxR * (0.45f + 0.55f * p),
                    style = Stroke(width = 1.dp.toPx()),
                )
            }
        }
        Box(
            modifier = Modifier
                .graphicsLayer { translationY = if (reduced) 0f else bob }
                .size(64.dp)
                .clip(RoundedCornerShape(MahiRadius.large))
                .background(c.surfaceElevated)
                .border(1.dp, accent.copy(alpha = 0.4f), RoundedCornerShape(MahiRadius.large)),
            contentAlignment = Alignment.Center,
        ) {
            Icon(icon, contentDescription = null, tint = accent, modifier = Modifier.size(MahiSize.iconMedium + 4.dp))
        }
    }
}

