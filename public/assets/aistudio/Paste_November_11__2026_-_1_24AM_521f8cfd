"use client";

import {
  useEffect,
  useRef,
  type HTMLAttributes,
  type PointerEvent,
  type ReactNode,
} from "react";

interface TiltCardProps extends HTMLAttributes<HTMLDivElement> {
  children: ReactNode;
  /** Maximum rotation in degrees on each axis. */
  maxTilt?: number;
  /** Champagne specular highlight that follows the pointer. */
  glare?: boolean;
}

/**
 * 3D perspective card. Rotation and glare position are written straight to CSS
 * variables (no React re-renders while moving). Touch input and
 * prefers-reduced-motion disable the effect entirely.
 */
export function TiltCard({
  children,
  maxTilt = 8,
  glare = true,
  className = "",
  style,
  onPointerMove,
  onPointerLeave,
  ...rest
}: TiltCardProps) {
  const ref = useRef<HTMLDivElement>(null);
  const frame = useRef<number | null>(null);

  useEffect(() => {
    return () => {
      if (frame.current !== null) cancelAnimationFrame(frame.current);
    };
  }, []);

  function handleMove(event: PointerEvent<HTMLDivElement>) {
    onPointerMove?.(event);
    if (event.pointerType === "touch") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const el = ref.current;
    if (!el) return;

    const rect = el.getBoundingClientRect();
    const px = (event.clientX - rect.left) / rect.width;
    const py = (event.clientY - rect.top) / rect.height;

    if (frame.current !== null) cancelAnimationFrame(frame.current);
    frame.current = requestAnimationFrame(() => {
      el.style.setProperty("--tilt-x", `${(0.5 - py) * 2 * maxTilt}deg`);
      el.style.setProperty("--tilt-y", `${(px - 0.5) * 2 * maxTilt}deg`);
      el.style.setProperty("--glare-x", `${px * 100}%`);
      el.style.setProperty("--glare-y", `${py * 100}%`);
    });
  }

  function handleLeave(event: PointerEvent<HTMLDivElement>) {
    onPointerLeave?.(event);
    const el = ref.current;
    if (!el) return;
    if (frame.current !== null) cancelAnimationFrame(frame.current);
    el.style.setProperty("--tilt-x", "0deg");
    el.style.setProperty("--tilt-y", "0deg");
  }

  return (
    <div
      ref={ref}
      onPointerMove={handleMove}
      onPointerLeave={handleLeave}
      className={`group relative mahi-panel-elevated transition-transform duration-200 ease-out will-change-transform ${className}`}
      style={{
        transform:
          "perspective(900px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg))",
        transformStyle: "preserve-3d",
        ...style,
      }}
      {...rest}
    >
      {children}
      {glare ? (
        <span
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 rounded-[inherit] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style={{
            background:
              "radial-gradient(260px circle at var(--glare-x, 50%) var(--glare-y, 50%), rgba(213,183,122,0.14), transparent 70%)",
          }}
        />
      ) : null}
    </div>
  );
}
