    onValueChange: (String) -> Unit,
    label: String,
    modifier: Modifier = Modifier,
    placeholder: String = "",
    leadingIcon: ImageVector? = null,
    enabled: Boolean = true,
    singleLine: Boolean = true,
    errorText: String? = null,
    supportingText: String? = null,
    keyboardOptions: KeyboardOptions = KeyboardOptions.Default,
    keyboardActions: KeyboardActions = KeyboardActions.Default,
    visualTransformation: VisualTransformation = VisualTransformation.None,
) {
    val c = MahiTheme.colors
    val shape = RoundedCornerShape(MahiRadius.medium)
    val interaction = remember { MutableInteractionSource() }
    val focused by interaction.collectIsFocusedAsState()
    val isError = errorText != null

    val borderColor by animateColorAsState(
        targetValue = when {
            isError -> c.error
            focused -> c.cyan
            else -> c.border
        },
        animationSpec = tween(MahiMotion.STANDARD_MS),
        label = "fieldBorder",
    )
    val labelColor by animateColorAsState(
        targetValue = when {
            isError -> c.error
            focused -> c.cyan
            else -> c.textSecondary
        },
        animationSpec = tween(MahiMotion.STANDARD_MS),
        label = "fieldLabel",
    )
    val glow by animateFloatAsState(
        targetValue = if (focused || isError) 0.22f else 0f,
        animationSpec = tween(MahiMotion.STANDARD_MS),
        label = "fieldGlow",
    )

    BasicTextField(
        value = value,
        onValueChange = onValueChange,
        modifier = modifier,
        enabled = enabled,
        singleLine = singleLine,
        textStyle = MaterialTheme.typography.bodyLarge.copy(color = c.textPrimary),
        cursorBrush = SolidColor(c.cyan),
        keyboardOptions = keyboardOptions,
        keyboardActions = keyboardActions,
        visualTransformation = visualTransformation,
        interactionSource = interaction,
        decorationBox = { inner ->
            Column {
                Text(
                    text = label,
                    style = MaterialTheme.typography.labelMedium,
                    color = labelColor,
                    modifier = Modifier.padding(start = MahiSpacing.xs, bottom = MahiSpacing.xs + 2.dp),
                )
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(MahiSize.inputHeight)
                        .drawBehind {
                            if (glow > 0f) {
                                drawRoundRect(
                                    color = borderColor.copy(alpha = glow),
                                    cornerRadius = CornerRadius(MahiRadius.medium.toPx()),
                                    style = Stroke(width = 6.dp.toPx()),
                                )
                            }
                        }
                        .clip(shape)
                        .background(c.surface)
                        .border(1.dp, borderColor, shape)
                        .padding(horizontal = MahiSpacing.lg),
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(MahiSpacing.md),
                ) {
                    if (leadingIcon != null) {
                        Icon(
                            imageVector = leadingIcon,
                            contentDescription = null,
                            tint = if (focused) c.cyan else c.textMuted,
                            modifier = Modifier.size(MahiSize.iconMedium - 4.dp),
                        )
                    }
                    Box(modifier = Modifier.weight(1f), contentAlignment = Alignment.CenterStart) {
                        if (value.isEmpty() && placeholder.isNotEmpty()) {
                            Text(
                                text = placeholder,
                                style = MaterialTheme.typography.bodyLarge,
                                color = c.textMuted,
                            )
                        }
                        inner()
                    }
                }
                val helper = errorText ?: supportingText
                AnimatedVisibility(
                    visible = helper != null,
                    enter = fadeIn(tween(MahiMotion.STANDARD_MS)) + expandVertically(tween(MahiMotion.STANDARD_MS)),
                    exit = fadeOut(tween(MahiMotion.FAST_MS)) + shrinkVertically(tween(MahiMotion.FAST_MS)),
                ) {
                    Text(
                        text = helper.orEmpty(),
                        style = MaterialTheme.typography.bodySmall,
                        color = if (isError) c.error else c.textMuted,
                        modifier = Modifier.padding(start = MahiSpacing.xs, top = MahiSpacing.xs + 2.dp),
                    )
                }
            }
        },
    )
}

/**
 * Six-box OTP entry backed by ONE hidden text field, so paste, autofill, and the existing
 * `otp_input` test tag all keep working. Digits pop in, the active cell has a blinking
 * caret, and incrementing [shakeTrigger] plays an error shake.
 */
@Composable
fun MahiOtpInput(
    value: String,
    onValueChange: (String) -> Unit,
    modifier: Modifier = Modifier,
    length: Int = 6,
    enabled: Boolean = true,
    isError: Boolean = false,
    shakeTrigger: Int = 0,
    onComplete: (String) -> Unit = {},
) {
    val c = MahiTheme.colors
    val interaction = remember { MutableInteractionSource() }
    val focused by interaction.collectIsFocusedAsState()

    BasicTextField(
        value = value,
        onValueChange = { raw ->
            val digits = raw.filter { it.isDigit() }.take(length)
            onValueChange(digits)
            if (digits.length == length) onComplete(digits)
        },
        modifier = modifier,
        enabled = enabled,
        singleLine = true,
        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
        interactionSource = interaction,
        cursorBrush = SolidColor(c.cyan.copy(alpha = 0f)),
        textStyle = MaterialTheme.typography.titleLarge.copy(color = c.textPrimary),
        decorationBox = {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .mahiShake(shakeTrigger),
                horizontalArrangement = Arrangement.spacedBy(MahiSpacing.sm),
            ) {
                repeat(length) { index ->
                    OtpCell(
                        char = value.getOrNull(index),
                        isActive = focused && enabled && index == value.length,
                        isError = isError,
                        modifier = Modifier.weight(1f),
                    )
                }
            }
        },
    )
}

@Composable
private fun OtpCell(
    char: Char?,
    isActive: Boolean,
    isError: Boolean,
    modifier: Modifier = Modifier,
) {
    val c = MahiTheme.colors
    val shape = RoundedCornerShape(MahiRadius.medium)
    val border by animateColorAsState(
        targetValue = when {
            isError -> c.error
            isActive -> c.cyan
            char != null -> c.champagne.copy(alpha = 0.6f)
            else -> c.border
        },
        animationSpec = tween(MahiMotion.STANDARD_MS),
        label = "otpBorder",
    )
    val lift by animateFloatAsState(
        targetValue = if (isActive) 1.04f else 1f,
        animationSpec = tween(MahiMotion.STANDARD_MS),
        label = "otpLift",
    )
    val caretTransition = rememberInfiniteTransition(label = "otpCaret")
    val caretAlpha by caretTransition.animateFloat(
        initialValue = 1f,
        targetValue = 0f,
        animationSpec = infiniteRepeatable(tween(520), RepeatMode.Reverse),
        label = "caretAlpha",
    )

    Box(
        modifier = modifier
            .height(MahiSize.inputHeight + 4.dp)
            .graphicsLayer {
                scaleX = lift
                scaleY = lift
            }
            .clip(shape)
            .background(c.surface)
            .border(if (isActive) 1.5.dp else 1.dp, border, shape),
        contentAlignment = Alignment.Center,
    ) {
        AnimatedContent(
            targetState = char,
            transitionSpec = {
                (fadeIn(tween(160)) + scaleIn(initialScale = 0.5f)) togetherWith fadeOut(tween(80))
            },
            contentAlignment = Alignment.Center,
            label = "otpDigit",
        ) { digit ->
            if (digit != null) {
                Text(
                    text = digit.toString(),
                    style = MaterialTheme.typography.headlineSmall,
                    color = c.textPrimary,
                    textAlign = TextAlign.Center,
                )
            }
        }
        if (isActive && char == null) {
            Box(
                modifier = Modifier
                    .width(2.dp)
                    .height(24.dp)
                    .graphicsLayer { alpha = caretAlpha }
                    .background(c.cyan),
            )
        }
    }
}
