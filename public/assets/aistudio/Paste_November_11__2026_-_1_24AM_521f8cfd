"use client";

import { useEffect, useRef, useState, type ElementType, type ReactNode } from "react";

interface RevealProps {
  children: ReactNode;
  /** Stagger index; each step adds 70ms of delay (capped at 10). */
  index?: number;
  as?: ElementType;
  className?: string;
}

/**
 * Scroll-triggered entrance: fades and rises into place once, the first time the
 * element enters the viewport. Falls back to visible without IntersectionObserver.
 * The global reduced-motion rule in globals.css shortens the transition to near-zero.
 */
export function Reveal({ children, index = 0, as: Tag = "div", className = "" }: RevealProps) {
  const ref = useRef<HTMLElement | null>(null);
  const [visible, setVisible] = useState(false);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    if (typeof IntersectionObserver === "undefined") {
      setVisible(true);
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          setVisible(true);
          observer.disconnect();
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
    );
    observer.observe(el);
    return () => observer.disconnect();
  }, []);

  return (
    <Tag
      ref={ref}
      className={`transition-[opacity,transform] duration-700 ease-[cubic-bezier(0.2,0,0,1)] ${
        visible ? "translate-y-0 opacity-100" : "translate-y-4 opacity-0"
      } ${className}`}
      style={{ transitionDelay: visible ? `${Math.min(index, 10) * 70}ms` : "0ms" }}
    >
      {children}
    </Tag>
  );
}
