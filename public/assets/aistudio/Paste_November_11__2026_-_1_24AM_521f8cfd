) {
    val c = MahiTheme.colors
    val reduced = rememberReducedMotion()
    val density = LocalDensity.current.density
    val currentOnFinished by rememberUpdatedState(onFinished)

    val draw = remember { Animatable(0f) }
    val rotY = remember { Animatable(-70f) }
    val rotX = remember { Animatable(18f) }
    val textIn = remember { Animatable(0f) }
    val shine = remember { Animatable(0f) }
    val bar = remember { Animatable(0f) }

    LaunchedEffect(Unit) {
        if (reduced) {
            draw.snapTo(1f)
            rotY.snapTo(0f)
            rotX.snapTo(0f)
            textIn.snapTo(1f)
            bar.snapTo(1f)
            delay(600)
            currentOnFinished()
            return@LaunchedEffect
        }
        coroutineScope {
            launch { draw.animateTo(1f, tween(1100, easing = MahiMotion.Emphasized)) }
            launch { rotY.animateTo(0f, spring(dampingRatio = 0.62f, stiffness = Spring.StiffnessVeryLow)) }
            launch { rotX.animateTo(0f, spring(dampingRatio = 0.7f, stiffness = Spring.StiffnessVeryLow)) }
            launch { delay(700); textIn.animateTo(1f, tween(800, easing = MahiMotion.Emphasized)) }
            launch { delay(1200); shine.animateTo(1f, tween(900, easing = FastOutSlowInEasing)) }
            launch { bar.animateTo(1f, tween(holdMs.toInt(), easing = LinearEasing)) }
        }
        currentOnFinished()
    }

    val orbitTransition = rememberInfiniteTransition(label = "splashOrbit")
    val orbit by orbitTransition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(tween(6000, easing = LinearEasing)),
        label = "orbitAngle",
    )

    MahiAmbientBackground(modifier = modifier.fillMaxSize(), intensity = 1.2f) {
        Column(
            modifier = Modifier.align(Alignment.Center),
            horizontalAlignment = Alignment.CenterHorizontally,
        ) {
            Box(contentAlignment = Alignment.Center, modifier = Modifier.size(240.dp)) {
                // Orbit ring, flattened with rotationX so it reads as a 3D halo.
                Canvas(
                    modifier = Modifier
                        .size(230.dp)
                        .graphicsLayer {
                            rotationX = 68f
                            rotationZ = if (reduced) 0f else orbit
                            cameraDistance = 16f * density
                            alpha = draw.value
                        },
                ) {
                    val radius = size.minDimension / 2f - 4.dp.toPx()
                    drawCircle(
                        brush = Brush.sweepGradient(
                            listOf(Color.Transparent, c.cyan.copy(alpha = 0.7f), Color.Transparent),
                            center = center,
                        ),
                        radius = radius,
                        style = Stroke(width = 1.5.dp.toPx()),
                    )
                    drawCircle(
                        color = c.cyan,
                        radius = 3.5.dp.toPx(),
                        center = Offset(center.x + radius, center.y),
                    )
                }
                // Logo mark.
                Canvas(
                    modifier = Modifier
                        .size(150.dp)
                        .graphicsLayer {
                            rotationY = rotY.value
                            rotationX = rotX.value
                            cameraDistance = 14f * density
                            alpha = (draw.value * 2f).coerceIn(0f, 1f)
                        },
                ) {
                    drawLogoMark(
                        draw = draw.value,
                        shine = shine.value,
                        champagne = c.champagne,
                        cyan = c.cyan,
                        fill = c.surface,
                    )
                }
            }

            Text(
                text = "MAHI REPAIR",
                style = MaterialTheme.typography.titleLarge.copy(
                    fontWeight = FontWeight.SemiBold,
                    letterSpacing = (14f - 8f * textIn.value).sp,
                ),
                color = c.textPrimary,
                modifier = Modifier
                    .padding(top = 8.dp)
                    .graphicsLayer {
                        alpha = textIn.value
                        translationY = (1f - textIn.value) * 12.dp.toPx()
                    },
            )
        }

        // Minimal progress hairline, kept clear of the navigation bar.
        Box(
            modifier = Modifier
                .align(Alignment.BottomCenter)
                .windowInsetsPadding(WindowInsets.navigationBars)
                .padding(bottom = 48.dp)
                .width(120.dp)
                .height(2.dp)
                .clip(androidx.compose.foundation.shape.CircleShape)
                .background(c.border),
        ) {
            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .graphicsLayer {
                        scaleX = bar.value
                        transformOrigin = androidx.compose.ui.graphics.TransformOrigin(0f, 0.5f)
                    }
                    .background(Brush.horizontalGradient(listOf(c.champagne, c.cyan))),
            )
        }
    }
}

private fun Path.trimmed(progress: Float): Path {
    val measure = PathMeasure()
    measure.setPath(this, false)
    val out = Path()
    measure.getSegment(0f, measure.length * progress.coerceIn(0f, 1f), out, true)
    return out
}

private fun DrawScope.drawLogoMark(
    draw: Float,
    shine: Float,
    champagne: Color,
    cyan: Color,
    fill: Color,
) {
    val s = size.minDimension
    val cx = size.width / 2f
    val cy = size.height / 2f
    val r = s * 0.46f

    val hex = Path().apply {
        for (i in 0..5) {
            val a = (-90.0 + 60.0 * i) * PI / 180.0
            val x = cx + r * cos(a).toFloat()
            val y = cy + r * sin(a).toFloat()
            if (i == 0) moveTo(x, y) else lineTo(x, y)
        }
        close()
    }
    val monogram = Path().apply {
        moveTo(cx - 0.34f * r, cy + 0.30f * r)
        lineTo(cx - 0.34f * r, cy - 0.30f * r)
        lineTo(cx, cy + 0.08f * r)
        lineTo(cx + 0.34f * r, cy - 0.30f * r)
        lineTo(cx + 0.34f * r, cy + 0.30f * r)
    }

    val bandStart = Offset(-s + shine * 3f * s, 0f)
    val stroke = Brush.linearGradient(
        0f to champagne,
        0.4f to champagne,
        0.5f to Color.White,
        0.6f to cyan,
        1f to champagne,
        start = bandStart,
        end = Offset(bandStart.x + s, s),
    )
    val width = s * 0.035f

    drawPath(hex, color = fill.copy(alpha = draw))
    drawPath(
        hex.trimmed(draw),
        color = champagne.copy(alpha = 0.16f),
        style = Stroke(width = width * 3f, cap = StrokeCap.Round, join = StrokeJoin.Round),
    )
    drawPath(
        hex.trimmed(draw),
        brush = stroke,
        style = Stroke(width = width, cap = StrokeCap.Round, join = StrokeJoin.Round),
    )
    drawPath(
        monogram.trimmed(((draw - 0.3f) / 0.7f)),
        brush = stroke,
        style = Stroke(width = width * 1.3f, cap = StrokeCap.Round, join = StrokeJoin.Round),
    )
}
