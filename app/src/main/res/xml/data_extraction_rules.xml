<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevent DataStore session credentials, tokens, and device identity from cloud restore -->
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="datastore/mahi_repair_prefs.preferences_pb" />
        <exclude domain="database" path="mahi_repair.db" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Prevent device identity and session credentials from being transferred to another device -->
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="datastore/mahi_repair_prefs.preferences_pb" />
        <exclude domain="database" path="mahi_repair.db" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
