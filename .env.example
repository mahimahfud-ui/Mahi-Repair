# Public Supabase client configuration for Mahi Repair.
# These values are intentionally public and may be embedded in the Android app.
# All privileged authorization is enforced by RLS and authenticated Edge Functions.
SUPABASE_URL="https://shwqsljicmhflnvjqjah.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_0CTwnNxJwNCrGXvqhdbq7Q_zW5v5C72"

# Public verification key only. Replace this placeholder with the X.509 PEM
# whose matching RSA-3072 PKCS#8 private key is stored in Supabase Edge Function
# Secrets as RECIPE_SIGNING_PRIVATE_KEY_PEM. Never put the private key here.
RECIPE_SIGNING_PUBLIC_KEY_PEM="REPLACE_WITH_MATCHING_PUBLIC_KEY_PEM"

# Web-only values are ignored by the Android Secrets Gradle Plugin.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
