# Mahi Repair Cloud Supabase Backend Configuration
SUPABASE_URL="https://placeholder.supabase.co"
SUPABASE_ANON_KEY="placeholder-anon-key"

# Public key only; match the PKCS#8 private key stored as a Supabase Edge Function secret.
# Accepts PEM (BEGIN PUBLIC KEY) or Base64 X.509 DER. This key is safe to bundle in the APK.
RECIPE_SIGNING_PUBLIC_KEY_PEM=""
